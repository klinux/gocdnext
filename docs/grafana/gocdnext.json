          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "clamp(ceil((max(gocdnext_queue_depth{stage_status=\"dispatchable\"}) + sum(gocdnext_agent_jobs_running)) / 6), 6, 10)",
